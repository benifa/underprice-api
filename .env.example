# App
UNDERPRICE_ENV=dev
UNDERPRICE_LOG_LEVEL=INFO

# Auth (MVP: shared device JWT secret — replace with Firebase later)
UNDERPRICE_AUTH_SECRET=change-me-in-prod

# Fine-tuned list-price specialist (Hub PEFT from price-engine publish)
UNDERPRICE_ADAPTER_ID=benifa/list-price-qlora
UNDERPRICE_ADAPTER_REVISION=v0.1.0
UNDERPRICE_BASE_MODEL=meta-llama/Llama-3.2-3B
HF_TOKEN=

# Cascade thresholds
UNDERPRICE_MEDIAN_GATE=0.95
UNDERPRICE_HOT_DEAL=0.70
UNDERPRICE_GRAY_ZONE_LOW=0.70
UNDERPRICE_GRAY_ZONE_HIGH=0.90
UNDERPRICE_CACHE_TTL_DAYS=14

# Modal (production GPU path)
UNDERPRICE_MODAL_APP=underprice
UNDERPRICE_USE_MODAL_GPU=false
UNDERPRICE_USE_MODAL_DICT=false

# Postgres (Neon/Supabase). Empty → in-memory store.
# Also accepted as bare DATABASE_URL=
UNDERPRICE_DATABASE_URL=
DATABASE_URL=

# Scanner / DealNews RSS (Ed week-8 sources)
UNDERPRICE_USE_SCANNER_LLM=true
UNDERPRICE_MAX_SCAN_CANDIDATES=5
OPENAI_API_KEY=

